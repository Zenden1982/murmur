# ─────────────────────────────────────────────────────────────
#  Murmur — настройки развёртывания (скопировать в .env)
#  Секреты (LIVEKIT_API_*) заполняет scripts/gen-keys.sh — руками не вписывать.
# ─────────────────────────────────────────────────────────────

# Что поднимать на ЭТОМ хосте (docker compose profiles):
#   media    — LiveKit (SFU + встроенный TURN)
#   caddy    — TLS для lk./turn. (и api. в standalone), сертификаты Let's Encrypt сам
#   backend  — наш API (аккаунты, каналы, токены, чат)
# Примеры:
#   один сервер «под ключ»:               media,caddy,backend
#   медиа-хост за внешним SNI-прокси:     media,caddy      (+ CADDY_LISTEN=127.0.0.1:8443)
#   только API за своим reverse proxy:    backend
COMPOSE_PROFILES=media,caddy,backend

# ── Образы ──
# Готовые образы с GitHub (на сервере ничего не собирается): docker compose pull && docker compose up -d --no-build.
# Закомментировать все три — собирать из исходников (docker compose build; нужен git clone всего репозитория).
# Версия: номер выпуска (например 0.3.13) или latest. Копия LiveKit — с тем же тегом версии, что в docker-compose.yml.
MURMUR_VERSION=latest
BACKEND_IMAGE=ghcr.io/zenden1982/murmur-backend:latest
CADDY_IMAGE=ghcr.io/zenden1982/murmur-caddy:latest
LIVEKIT_IMAGE=ghcr.io/zenden1982/murmur-livekit:v1.13.11

# ── Имена (A-записи DNS → публичный IP медиа-хоста; API — туда, где бэкенд) ──
# Своего домена нет — бесплатные имена по IP (sslip.io), например для 85.12.34.56:
#   lk.85-12-34-56.sslip.io, turn.85-12-34-56.sslip.io, api.85-12-34-56.sslip.io  (DNS настраивать не нужно)
LK_DOMAIN=lk.example.com
TURN_DOMAIN=turn.example.com
API_DOMAIN=api.example.com
# Дополнительные имена (через запятую, без пробелов) — сертификаты и маршруты на них тоже. Например, прежние имена
# sslip.io после перехода на свой домен: у друзей в клиенте остался старый адрес — он продолжит работать.
LK_DOMAIN_ALIASES=
TURN_DOMAIN_ALIASES=
API_DOMAIN_ALIASES=
# Caddy выпускает сертификат для API_DOMAIN только если 1 (standalone). За внешним прокси — 0.
CADDY_SERVE_API=1
ACME_EMAIL=admin@example.com
# Для отладки выдачи сертификатов: тестовый CA Let's Encrypt (без лимитов, сертификат недоверенный)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# CADDY_LOG_LEVEL=DEBUG

# ── Сеть медиа-хоста ──
# Публичный IP. Пусто — LiveKit определит сам через STUN.
PUBLIC_IP=
# Где слушает Caddy: ":443" (standalone) или "127.0.0.1:8443" (за nginx stream / другим SNI-прокси).
CADDY_LISTEN=:443
# Порты медиа (открыть в firewall наружу): TCP-фолбэк, UDP (один мультиплекс-порт), TURN/UDP
LK_TCP_PORT=7881
LK_UDP_PORT=7882
# Сетевые интерфейсы для медиа (через запятую). Пусто = все. Задать внешний (напр. eth0), если на хосте есть WireGuard/туннели.
LK_RTC_INTERFACES=
TURN_UDP_PORT=3478

# ── Комнаты ──
LK_MAX_PARTICIPANTS=20
# Куда LiveKit шлёт вебхуки «вошёл/вышел» (бэкенд Murmur): https://api.example.com/livekit/webhook;
# если бэкенд рядом в том же compose — http://127.0.0.1:8080/livekit/webhook. Пусто — без вебхуков.
LK_WEBHOOK_URL=

# ── Бэкенд ──
BACKEND_BIND=127.0.0.1:8080
# Где хранить SQLite: имя docker-тома (по умолчанию backend-data) или папка хоста, напр. /srv/data/amadeus/backend
# (папку заранее: chown 10001 — в контейнере бэкенд работает от uid 10001)
# BACKEND_DATA=backend-data
# Внешний адрес LiveKit, который бэкенд отдаёт клиентам
LIVEKIT_PUBLIC_URL=wss://lk.example.com
# IP клиента для rate limit. Standalone (CADDY_SERVE_API=1): берётся из PROXY v2 от Caddy, оставить 0.
# За своим HTTP reverse proxy (nginx/NPM): 1 — последний адрес в X-Forwarded-For (его дописал прокси).
TRUSTED_PROXY_HOPS=0

# Обновления клиента: если своих выпусков нет (их кладёт только scripts/release.sh владельца), бэкенд берёт
# номер новой версии у официального сервера Murmur и отправляет клиентов за файлом туда же.
# Не задано — https://api.murmurchat.ru; пустая строка (UPDATES_UPSTREAM=) — выключено.
# UPDATES_UPSTREAM=https://api.murmurchat.ru

# ── Секреты (scripts/gen-keys.sh) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Прокси для сборки/скачивания (сервер в РФ: Docker Hub, crates.io, GitHub) ──
# HTTP_PROXY=http://host.docker.internal:20171
# HTTPS_PROXY=http://host.docker.internal:20171
# NO_PROXY=localhost,127.0.0.1,backend
